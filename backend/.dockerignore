# Що НЕ потрапляє в контекст збірки образу.
#
# Контекст цілком передається демону Docker перед збіркою, тому зайві файли —
# це і повільніша збірка, і ризик залишити секрет усередині шару.

# Результати локальної збірки: у контейнері все збирається наново, а .class
# з іншої JVM тут лише заважали б.
target/

# СЕКРЕТИ. Файли гітігноровані, але .gitignore на docker build не діє — без цих
# рядків локальний JWT-секрет і пароль до БД поїхали б в образ і залишились би
# у його шарах назавжди, навіть якщо потім видалити файл наступною командою.
src/main/resources/application-local.properties
.env
.env.*

# Локальний Postgres для розробки. У продакшені база керована, а цей файл ще й
# містить dev-креденшели myuser/secret.
compose.yaml

# Maven wrapper не потрібен: у першому етапі використовується образ із Maven.
.mvn/
mvnw
mvnw.cmd

# Службове
.git/
.gitignore
.idea/
.vscode/
*.iml
HELP.md
