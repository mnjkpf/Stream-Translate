# Копія для локальної розробки: скопіюй у application-local.properties
# (без .example) і встав реальний секрет. Той файл гітігнорений.
#
# Згенерувати новий секрет:  openssl rand -base64 32
# Для продакшена цей файл не використовується — секрет передається через
# env var / секрет-менеджер хостингу, не файлом у репозиторії.

app.jwt.secret=REPLACE_WITH_GENERATED_BASE64_SECRET
