# Зразок змінних для локального запуску контейнера.
# Скопіюй у .env (той гітігнорений) і підстав свої значення:
#   copy backend\.env.example backend\.env
#
# Формат docker --env-file: КЛЮЧ=значення, БЕЗ лапок і без пробілів навколо "=".
# Лапки стали б частиною значення — це найчастіша помилка в таких файлах.
# Коментарі з # допускаються лише на власному рядку.

SPRING_PROFILES_ACTIVE=prod

# Рядок підключення з панелі Neon, перероблений під JDBC:
#   * префікс jdbc:
#   * без логіна й пароля в самому URL (вони окремими змінними нижче)
#   * без "-pooler" у хості: пулер працює в режимі транзакційного пулінгу, а
#     Hibernate використовує серверні prepared statements, які там ламаються
#   * без channel_binding: JDBC-драйвер такого параметра не знає (у нього це
#     channelBinding), а шифрування вже дає sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-приклад.eu-west-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=встав_свій_пароль

# Підписує НАШІ JWT. Згенеруй новий і збережи — при зміні всі видані токени
# стають невалідними, тобто всі користувачі розлогінюються. Get-Random тут не
# годиться: це звичайний PRNG, а не криптографічний, і його вихід передбачуваний.
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
APP_JWT_SECRET=встав_згенерований_секрет

# Шифрує ключі Gemini користувачів у базі (AES-256, base64, РІВНО 32 байти).
# Генерація та сама, що й для JWT-секрету — вона дає рівно 32 байти.
# Значення мусить бути ІНШИМ, ніж APP_JWT_SECRET: один ключ на дві різні
# криптографічні задачі — це зайва зв'язність, при заміні одного ламається інше.
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Порожнє значення = ключі лежать відкритим текстом, застосунок пише WARN на старті.
# Змінювати цей ключ після запуску не варто: вже збережені ключі стануть
# нечитабельними, і користувачам доведеться ввести їх заново.
APP_SETTINGS_SECRET=встав_окремий_секрет

# Ключ для проксі-перекладу вбудованим ключем. Можна лишити порожнім —
# тоді /translate просто віддаватиме 503, а переклад власним ключем працює.
GEMINI_API_KEY=
